# ==============================================================================
# AI Research Discovery and Evidence Engine - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16 with pgvector extension)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airesearch
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# Security & JWT Token Authentication
# Secret key must be at least 256 bits (32 bytes) for HMAC-SHA256
APP_SECURITY_JWT_SECRET=super_secret_jwt_key_that_is_at_least_256_bits_long_for_security_assurance_2026
APP_SECURITY_JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
APP_SECURITY_JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# AI & RAG Provider Options: 'mock' (default, zero setup needed) or 'ollama'
APP_AI_PROVIDER=mock

# Ollama Configuration (Only required when APP_AI_PROVIDER=ollama)
APP_AI_OLLAMA_BASE_URL=http://localhost:11434
APP_AI_OLLAMA_EMBEDDING_MODEL=all-minilm
APP_AI_OLLAMA_CHAT_MODEL=llama3.2
APP_AI_EMBEDDING_DIMENSION=384

# Document Ingestion Storage
APP_INGESTION_UPLOAD_DIR=./uploads

# Server Port
PORT=8080
