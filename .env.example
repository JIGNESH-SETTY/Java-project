# ==============================================================================
# AI Research Discovery and Evidence Engine - Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Profile & Ports
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
PORT=8080
FRONTEND_PORT=3001
APP_BASE_URL=https://api.yourdomain.edu
FRONTEND_URL=https://app.yourdomain.edu

# Database (PostgreSQL 16 with pgvector extension)
DATABASE_URL=jdbc:postgresql://localhost:5434/airesearch
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_SSL_MODE=disable

# Authentication & JWT Security (Secret must be at least 32 bytes)
JWT_SECRET=super_secret_jwt_key_that_is_at_least_256_bits_long_for_security_assurance_2026
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=14

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# Document File Storage ('local' for local dev, 's3' for production)
STORAGE_PROVIDER=local
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=airesearch-documents-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ==============================================================================
# AI Provider Configuration ('MOCK', 'OLLAMA', 'OPENAI', 'GEMINI', 'ANTHROPIC')
# ==============================================================================
AI_PROVIDER=MOCK
APP_AI_PROVIDER=MOCK
APP_AI_EMBEDDING_DIMENSION=384

# --- 1. OpenAI Configuration ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- 2. Google Gemini Configuration ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- 3. Anthropic Claude Configuration ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022

# --- 4. Self-Hosted Ollama Configuration ---
APP_AI_OLLAMA_BASE_URL=http://localhost:11434
APP_AI_OLLAMA_CHAT_MODEL=llama3:latest
APP_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Scholarly Metadata Providers & Polite Pools
CROSSREF_MAILTO=research-team@yourdomain.edu
OPENALEX_MAILTO=research-team@yourdomain.edu
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=research-team@yourdomain.edu
EUROPE_PMC_API_KEY=

# Document Processing & Ingestion Limits
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES_PER_PDF=150
ALLOWED_UPLOAD_TYPES=application/pdf
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300

# Rate Limiting (Token Bucket)
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=20
IMPORT_RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Observability & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
ACTUATOR_EXPOSED_ENDPOINTS=health,info,metrics
