# ==============================================================================
# AI Research Discovery and Evidence Engine - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Environment
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*~

# Environment files and credentials (keep .env.example tracked)
.env
*.env
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# Java & Maven (Backend)
# ------------------------------------------------------------------------------
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven runtime and log files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Application logs & uploaded document files
*.log
logs/
uploads/
backend/uploads/

# ------------------------------------------------------------------------------
# Node.js & Vite (Frontend)
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/build/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
frontend/.tmp/

# Testing & E2E artifacts (Playwright, Cypress)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# IDE & Code Editors
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.settings/
.classpath
.project
.metadata
bin/
tmp/
